      ]
    },
    {
      "term": "System Requirements Analysis",
      "definition": "Фаза 12-фазного инженерного представления SDLC (User_Provided_Summary viewpoint).",
      "category": "phase_12_viewpoint",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "System analysis",
      "alt_term_ru": "системный анализ",
      "definition": "Анализ поведения и свойств системы/ПО, включая компромиссы, ограничения и проверки согласованности.",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "TVPL",
      "definition": "Test or Validation Plan",
      "category": "abbreviation_plan",
      "sources": [
        "SDLC_12207_Synthesis.md"
      ]
    },
    {
      "term": "TVPR",
      "definition": "Test or Validation Procedures",
      "category": "abbreviation_procedure",
      "sources": [
        "SDLC_12207_Synthesis.md"
      ]
    },
    {
      "term": "TVRR",
      "definition": "Test or Validation Results Report",
      "category": "abbreviation_report",
      "sources": [
        "SDLC_12207_Synthesis.md"
      ]
    },
    {
      "term": "Tailoring",
      "alt_term_ru": "адаптация / tailoring",
      "definition": "Выбор и настройка процессов/деятельностей/заданий под проект и контекст. В 12207:2017 требования по tailoring вынесены в Annex A (normative) и применяются при заявлении «tailored conformance».",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "Task",
      "alt_term_ru": "задание (task)",
      "definition": "Атомарная единица требований стандарта: то, что «делается» в рамках деятельности. Важно: задачи не обязаны быть шагами последовательности и часто являются постоянными обязанностями, а их порядок не предписан.",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "Technical management processes",
      "alt_term_ru": "процессы технического управления",
      "definition": "Процессы управления на уровне проекта/технических аспектов (планирование, контроль, решения, риски, конфигурация, информация, измерения, качество).",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "Technical processes",
      "alt_term_ru": "технические процессы",
      "definition": "Процессы инженерии требований/архитектуры/дизайна/реализации/интеграции/верификации/валидации/перехода/эксплуатации/сопровождения/утилизации (2017).",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "Technical support (L1/L2/L3)",
      "alt_term_ru": "техническая поддержка (1/2/3 линия)",
      "definition": "Организационная модель сопровождения: 1 линия — приём/триаж; 2 линия — анализ и воспроизведение; 3 линия — разработка исправлений/экспертиза и релизы.",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "Test baseline",
      "alt_term_ru": "тестовая базовая линия",
      "definition": "Базовая линия, фиксирующая комплект тестов/планов/процедур для конкретного уровня интеграции/квалификации.",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "Testability review",
      "definition": "Ревью требований/дизайна с фокусом на проверяемость и раннюю подготовку тестов.",
      "category": "testing_practice",
      "sources": [
        "w-model.md",
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "Testing vs Debugging",
      "definition": "Разделение ролей и целей: тестирование выявляет дефекты, отладка локализует и устраняет причины.",
      "category": "testing_practice",
      "sources": [
        "w-model.md"
      ]
    },
    {
      "term": "Transition",
      "alt_term_ru": "переход (ввод в эксплуатацию)",
      "definition": "Перенос продукта в целевую среду: установка, настройка, обучение, миграция, подготовка эксплуатации.",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "UDD",
      "definition": "User Documentation Description",
      "category": "abbreviation_description",
      "sources": [
        "SDLC_12207_Synthesis.md"
      ]
    },
    {
      "term": "V-Model",
      "definition": "Классическая модель соответствия уровней разработки и тестирования; в W-model расширяется второй тестовой веткой.",
      "category": "testing_model",
      "sources": [
        "w-model.md"
      ]
    },
    {
      "term": "VV-Model",
      "definition": "Синоним W-Model в части усиленного фокуса на раннем тестировании.",
      "category": "testing_model",
      "sources": [
        "w-model.md"
      ]
    },
    {
      "term": "Validation",
      "alt_term_ru": "валидация",
      "definition": "Проверка: «сделали правильный продукт?» — соответствие потребностям заинтересованных сторон и назначению.",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "Verification",
      "alt_term_ru": "верификация",
      "definition": "Проверка: «сделали продукт правильно?» — соответствие реализации спецификациям и требованиям.",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "Viewpoint",
      "alt_term_ru": "точка зрения (viewpoint)",
      "definition": "Способ описания процессов/системы, ориентированный на конкретные интересы и аудиторию (роль, объект, контракт, оценка и т.п.).",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "W-Model",
      "definition": "Модель SDLC, усиливающая V-модель ранним и параллельным планированием тестирования для каждого артефакта разработки.",
      "category": "testing_model",
      "sources": [
        "w-model.md",
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "Walkthrough",
      "alt_term_ru": "прохождение / walkthrough",
      "definition": "Форма оценки, где автор «проводит» участников через продукт для выявления дефектов и достижения общего понимания.",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "Waterfall model",
      "alt_term_ru": "каскадная модель",
      "definition": "Классическая линейная модель, где результаты каждой стадии являются входом следующей; применима при стабильных требованиях.",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "Work product",
      "alt_term_ru": "рабочий продукт / артефакт",
      "definition": "Любой документ, программный компонент или запись, создаваемые процессом/деятельностью/заданием (спецификации, планы, отчёты, код, записи проверок и т.п.).",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    }
  ]
}
