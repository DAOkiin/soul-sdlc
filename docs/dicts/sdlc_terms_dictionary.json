      ]
    },
    {
      "term": "Architecture definition",
      "alt_term_ru": "определение архитектуры",
      "definition": "Процесс выработки архитектурного решения: компоненты, интерфейсы, распределение требований, ограничения.",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "Barrier",
      "definition": "Фактор, мешающий выполнить работу или достичь ожидаемого прогресса.",
