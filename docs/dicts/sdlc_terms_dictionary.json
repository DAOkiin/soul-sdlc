    {
      "term": "12-phase IEEE 12207 viewpoint",
      "definition": "Инженерная интерпретация SDLC как 12 фаз с артефактами и гейтами; не заменяет процессную структуру стандарта 12207.",
      "category": "sdlc_viewpoint",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "A1 Rationale",
      "definition": "Атрибут требования: обоснование, зачем требование существует и какую ценность покрывает.",
      "category": "requirement_attribute",
      "sources": [
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "A12 Condition of Use",
      "definition": "Атрибут требования: условия и контекст использования, при которых требование применимо.",
      "category": "requirement_attribute",
      "sources": [
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "A15 ReqID",
      "definition": "Атрибут требования: стабильный идентификатор требования для трассируемости.",
      "category": "requirement_attribute",
      "sources": [
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "A2 Trace to Parent",
      "definition": "Атрибут требования: ссылка на родительское требование или верхнеуровневый источник.",
      "category": "requirement_attribute",
      "sources": [
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "A26 Stability/Volatility",
      "definition": "Атрибут требования: оценка устойчивости требования к изменениям во времени.",
      "category": "requirement_attribute",
      "sources": [
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "A3 Trace to Source",
      "definition": "Атрибут требования: ссылка на первичный источник (evidence, интервью, наблюдение, данные).",
      "category": "requirement_attribute",
      "sources": [
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "A34 Priority",
      "definition": "Атрибут требования: приоритет относительно других требований/работ.",
      "category": "requirement_attribute",
      "sources": [
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "A36 Risk",
      "definition": "Атрибут требования: риск, связанный с невыполнением или неверной реализацией требования.",
      "category": "requirement_attribute",
      "sources": [
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "A6 Success Criteria",
      "definition": "Атрибут требования: измеримые критерии, по которым считается достигнутым успешный результат.",
      "category": "requirement_attribute",
      "sources": [
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "A7 Strategy",
      "definition": "Атрибут требования: стратегия верификации/валидации или достижения критерия успеха.",
      "category": "requirement_attribute",
      "sources": [
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "A8 Method",
      "definition": "Атрибут требования: конкретный метод проверки (тест, анализ, инспекция, демонстрация).",
      "category": "requirement_attribute",
      "sources": [
        "AJTBD-SDLC.md"
      ]
    },
    {
      "term": "AJTBD",
      "definition": "Advanced Jobs To Be Done: практический фреймворк Ивана Замесина, расширяющий JTBD графом работ, сегментацией и алгоритмами создания/коммуникации ценности.",
      "category": "ajtbd",
      "sources": [
        "AJTBD.md",
        "AJTBD-SDLC.md"
      ]
    },
    {
