      ]
    },
    {
      "term": "Build",
      "alt_term_ru": "сборка (build)",
      "definition": "Планируемый выпуск/пакет изменений продукта (в инкрементной модели определяется заранее и оценивается по «значимой функциональности»).",
      "category": "sdlc_glossary",
      "sources": [
        "SDLC_12207_Synthesis.md",
        "CAN_CSA_ISO_IEC_IEEE_12207-18.md"
      ]
    },
    {
      "term": "Change request",
      "alt_term_ru": "запрос на изменение",
